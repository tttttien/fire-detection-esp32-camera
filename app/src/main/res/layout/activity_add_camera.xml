<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingTop="1500dp">

    <!-- Header with Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">


        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:src="@drawable/ic_back"
            app:tint="#FF0000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Add New Camera"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Camera Index Input -->
    <EditText
        android:id="@+id/etCameraIndex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/edit_text"
        android:backgroundTint="#CCCCCC"
        android:hint="Camera Index (unique number for each camera)"
        android:inputType="number"
        android:padding="12dp" />

    <!-- Label Input -->
    <EditText
        android:id="@+id/etLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@android:drawable/edit_text"
        android:backgroundTint="#CCCCCC"
        android:hint="Label (e.g., Living Room, Kitchen)"
        android:padding="12dp" />

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:text="Save Camera"
        android:textColor="#FF0000"
        android:textSize="16sp" />

</LinearLayout>
