<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp bóng mờ bên ngoài -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
            <!-- Viền mờ đậm hơn + lan thêm 20% -->
            <stroke android:width="4dp" android:color="#40000000" /> <!-- #40 = ~25% mờ -->
        </shape>
    </item>

    <!-- Lớp nền chính của nút -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" /> <!-- nền trắng -->
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
