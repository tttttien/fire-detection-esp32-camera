<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme for the Splash Screen -->
    <style name="Theme.SplashScreen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item> <!-- Background image for splash screen -->
        <item name="android:windowFullscreen">true</item> <!-- Enables fullscreen mode -->
        <item name="android:windowNoTitle">true</item> <!-- Removes the title bar -->
    </style>

    <!-- Main application theme -->
    <style name="Theme.Camera" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Remove default colors to let layouts control their own colors -->
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="fontFamily">@font/montserrat</item>
    </style>

    <!-- Button Styles -->
    <style name="ButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:elevation">4dp</item>
    </style>


</resources>
